shrink-0 -mx-1\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></div><div class=\"flex items-center\"><div class=\"flex flex-col items-center gap-2 px-4 py-3 group\"><div class=\"w-10 h-10 rounded-xl flex items-center justify-center border transition-all\n                    bg-cyan-500/10 border-cyan-500/20 group-hover:bg-cyan-500/15 group-hover:border-cyan-500/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield w-4.5 h-4.5 text-cyan-400\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg></div><span class=\"text-[10px] font-bold text-white/20\">04</span><span class=\"text-xs text-white/50 text-center leading-tight max-w-[80px]\">QA validates output</span></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-3.5 h-3.5 text-white/15 shrink-0 -mx-1\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></div><div class=\"flex items-center\"><div class=\"flex flex-col items-center gap-2 px-4 py-3 group\"><div class=\"w-10 h-10 rounded-xl flex items-center justify-center border transition-all\n                    bg-teal-500/10 border-teal-500/20 group-hover:bg-teal-500/15 group-hover:border-teal-500/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye w-4.5 h-4.5 text-teal-400\" aria-hidden=\"true\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></div><span class=\"text-[10px] font-bold text-white/20\">05</span><span class=\"text-xs text-white/50 text-center leading-tight max-w-[80px]\">Preview live</span></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-3.5 h-3.5 text-white/15 shrink-0 -mx-1\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></div><div class=\"flex items-center\"><div class=\"flex flex-col items-center gap-2 px-4 py-3 group\"><div class=\"w-10 h-10 rounded-xl flex items-center justify-center border transition-all\n                    bg-emerald-500/10 border-emerald-500/20 group-hover:bg-emerald-500/15 group-hover:border-emerald-500/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud w-4.5 h-4.5 text-emerald-400\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg></div><span class=\"text-[10px] font-bold text-white/20\">06</span><span class=\"text-xs text-white/50 text-center leading-tight max-w-[80px]\">Deploy to Cloudflare</span></div></div></div></div></section><section id=\"features\" class=\"py-20 px-6\"><div class=\"max-w-5xl mx-auto\"><div class=\"text-center mb-14\"><h2 class=\"text-3xl font-bold tracking-tight mb-3\">Everything you need to ship</h2><p class=\"text-white/40 text-base max-w-md mx-auto\">From prompt to production. No context switching, no manual wiring.</p></div><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\"><div class=\"relative p-5 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all duration-200 group overflow-hidden\" style=\"--glow:rgba(139,92,246,0.12)\"><div class=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl\" style=\"background:radial-gradient(circle at 30% 30%, rgba(139,92,246,0.12), transparent 70%)\"></div><div class=\"relative w-9 h-9 rounded-xl bg-violet-500/10 border border-violet-500/15 flex items-center justify-center mb-4 group-hover:bg-violet-500/15 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square w-4 h-4 text-violet-400\" aria-hidden=\"true\"><path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"></path></svg></div><h3 class=\"relative text-sm font-semibold mb-1.5\">Chat to build</h3><p class=\"relative text-xs text-white/40 leading-relaxed\">Describe your app, then refine through conversation. Partial regen preserves your edits.</p></div><div class=\"relative p-5 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all duration-200 group overflow-hidden\" style=\"--glow:rgba(99,102,241,0.12)\"><div class=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl\" style=\"background:radial-gradient(circle at 30% 30%, rgba(99,102,241,0.12), transparent 70%)\"></div><div class=\"relative w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/15 flex items-center justify-center mb-4 group-hover:bg-indigo-500/15 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-code-xml w-4 h-4 text-indigo-400\" aria-hidden=\"true\"><path d=\"m18 16 4-4-4-4\"></path><path d=\"m6 8-4 4 4 4\"></path><path d=\"m14.5 4-5 16\"></path></svg></div><h3 class=\"relative text-sm font-semibold mb-1.5\">Live code editor</h3><p class=\"relative text-xs text-white/40 leading-relaxed\">Browse the file tree, edit any generated file, and see changes reflected immediately.</p></div><div class=\"relative p-5 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all duration-200 group overflow-hidden\" style=\"--glow:rgba(6,182,212,0.10)\"><div class=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl\" style=\"background:radial-gradient(circle at 30% 30%, rgba(6,182,212,0.10), transparent 70%)\"></div><div class=\"relative w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/15 flex items-center justify-center mb-4 group-hover:bg-cyan-500/15 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye w-4 h-4 text-cyan-400\" aria-hidden=\"true\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></div><h3 class=\"relative text-sm font-semibold mb-1.5\">Instant preview</h3><p class=\"relative text-xs text-white/40 leading-relaxed\">Every generation produces a live preview. No local setup required.</p></div><div class=\"relative p-5 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all duration-200 group overflow-hidden\" style=\"--glow:rgba(52,211,153,0.10)\"><div class=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl\" style=\"background:radial-gradient(circle at 30% 30%, rgba(52,211,153,0.10), transparent 70%)\"></div><div class=\"relative w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/15 flex items-center justify-center mb-4 group-hover:bg-emerald-500/15 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-git-branch w-4 h-4 text-emerald-400\" aria-hidden=\"true\"><path d=\"M15 6a9 9 0 0 0-9 9V3\"></path><circle cx=\"18\" cy=\"6\" r=\"3\"></circle><circle cx=\"6\" cy=\"18\" r=\"3\"></circle></svg></div><h3 class=\"relative text-sm font-semibold mb-1.5\">GitHub push</h3><p class=\"relative text-xs text-white/40 leading-relaxed\">One click to create a repo, commit all files, and push with a meaningful commit message.</p></div><div class=\"relative p-5 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all duration-200 group overflow-hidden\" style=\"--glow:rgba(59,130,246,0.10)\"><div class=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl\" style=\"background:radial-gradient(circle at 30% 30%, rgba(59,130,246,0.10), transparent 70%)\"></div><div class=\"relative w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/15 flex items-center justify-center mb-4 group-hover:bg-blue-500/15 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud w-4 h-4 text-blue-400\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg></div><h3 class=\"relative text-sm font-semibold mb-1.5\">Cloudflare deploy</h3><p class=\"relative text-xs text-white/40 leading-relaxed\">Auto-detect Pages vs Workers. Generate wrangler config and CI/CD workflow automatically.</p></div><div class=\"relative p-5 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all duration-200 group overflow-hidden\" style=\"--glow:rgba(251,146,60,0.10)\"><div class=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl\" style=\"background:radial-gradient(circle at 30% 30%, rgba(251,146,60,0.10), transparent 70%)\"></div><div class=\"relative w-9 h-9 rounded-xl bg-orange-500/10 border border-orange-500/15 flex items-center justify-center mb-4 group-hover:bg-orange-500/15 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-package w-4 h-4 text-orange-400\" aria-hidden=\"true\"><path d=\"M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z\"></path><path d=\"M12 22V12\"></path><polyline points=\"3.29 7 12 12 20.71 7\"></polyline><path d=\"m7.5 4.27 9 5.15\"></path></svg></div><h3 class=\"relative text-sm font-semibold mb-1.5\">ZIP export</h3><p class=\"relative text-xs text-white/40 leading-relaxed\">Download the full project with manifest, setup docs, and .env.example. Own your code.</p></div><div class=\"relative p-5 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all duration-200 group overflow-hidden\" style=\"--glow:rgba(236,72,153,0.10)\"><div class=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl\" style=\"background:radial-gradient(circle at 30% 30%, rgba(236,72,153,0.10), transparent 70%)\"></div><div class=\"relative w-9 h-9 rounded-xl bg-pink-500/10 border border-pink-500/15 flex items-center justify-center mb-4 group-hover:bg-pink-500/15 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-terminal w-4 h-4 text-pink-400\" aria-hidden=\"true\"><path d=\"M12 19h8\"></path><path d=\"m4 17 6-6-6-6\"></path></svg></div><h3 class=\"relative text-sm font-semibold mb-1.5\">Version history</h3><p class=\"relative text-xs text-white/40 leading-relaxed\">Every generation creates a rollback snapshot. Experiment freely, restore in one click.</p></div><div class=\"relative p-5 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all duration-200 group overflow-hidden\" style=\"--glow:rgba(168,85,247,0.10)\"><div class=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl\" style=\"background:radial-gradient(circle at 30% 30%, rgba(168,85,247,0.10), transparent 70%)\"></div><div class=\"relative w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/15 flex items-center justify-center mb-4 group-hover:bg-purple-500/15 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layers w-4 h-4 text-purple-400\" aria-hidden=\"true\"><path d=\"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z\"></path><path d=\"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12\"></path><path d=\"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17\"></path></svg></div><h3 class=\"relative text-sm font-semibold mb-1.5\">Multi-provider</h3><p class=\"relative text-xs text-white/40 leading-relaxed\">5 AI providers — GitHub Models, Mistral, Groq, OpenRouter, HuggingFace. Automatic failover.</p></div><div class=\"relative p-5 rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1] transition-all duration-200 group overflow-hidden\" style=\"--glow:rgba(20,184,166,0.10)\"><div class=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl\" style=\"background:radial-gradient(circle at 30% 30%, rgba(20,184,166,0.10), transparent 70%)\"></div><div class=\"relative w-9 h-9 rounded-xl bg-teal-500/10 border border-teal-500/15 flex items-center justify-center mb-4 group-hover:bg-teal-500/15 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database w-4 h-4 text-teal-400\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg></div><h3 class=\"relative text-sm font-semibold mb-1.5\">Supabase native</h3><p class=\"relative text-xs text-white/40 leading-relaxed\">Row-level security, per-user data isolation, and migrations included in every generated app.</p></div></div></div></section><section id=\"agents\" class=\"py-20 px-6 border-t border-white/[0.04]\"><div class=\"max-w-5xl mx-auto\"><div class=\"text-center mb-14\"><h2 class=\"text-3xl font-bold tracking-tight mb-3\">12 specialized agents</h2><p class=\"text-white/40 text-base\">Each agent is an expert. Together they build your entire app.</p></div><div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3\"><div class=\"flex items-center gap-2.5 p-3.5 rounded-xl border border-white/[0.06] bg-white/[0.02] hover:bg-violet-500/[0.06] hover:border-violet-500/20 transition-all group\"><div class=\"w-7 h-7 rounded-lg bg-violet-500/10 flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" 